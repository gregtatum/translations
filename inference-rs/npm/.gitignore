# Build artifacts and installed deps — never committed (same convention as
# crates/fxtranslate-wasm/pkg per notes/12). `wasm/` is copied in by
# `npm run build:wasm`; regenerate it, don't commit it.
node_modules/
wasm/

# `npm pack` output tarballs — build artifacts, never committed.
*.tgz

# The repo-root .gitignore ignores `lib/` (a Python/Rust artifact convention).
# Our hand-authored library sources live in npm/lib/ and MUST be tracked —
# un-ignore the directory and its files here.
!lib/
!lib/**
